# Copy only if apps/api/.env is absent; never overwrite existing credentials.
DATABASE_URL=postgresql://agencyops:change-me@localhost:5432/agencyops?schema=public
PORT=3001
WEB_URL=http://localhost:3000
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
# Public PEM key from Clerk Dashboard -> API keys -> Show JWT public key.
# Use literal backslash-n between PEM lines, or a dotenv quoted multiline value.
CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----\nreplace_me\n-----END PUBLIC KEY-----"
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
# Server-only: required by the SDK at API startup and for operator provisioning.
CLERK_SECRET_KEY=sk_test_replace_me
